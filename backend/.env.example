# Postgres / Supabase connection (use the "Session pooler" URI from Supabase project settings)
DATABASE_URL=postgresql://postgres:password@localhost:5432/propsync

# Gemini API key (Google AI Studio) - used for WhatsApp-text -> structured JSON extraction
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# Geocoding fallback (used when Gemini can't resolve an address to lat/lng itself)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# CORS - comma separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000
